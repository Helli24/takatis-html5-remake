// Cloudflare Worker that serves the built game (dist/index.html) as a static asset.
// Build: pip install -r requirements.txt && python game/build.py
{
  "name": "takatis",
  "compatibility_date": "2026-09-30",
  // temporary: every request runs worker/log.js first, which logs it and passes it on to the assets
  "main": "worker/log.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
  "preview_urls": false
}
